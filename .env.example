# --- Frontend (brauzerə düşür, yalnız açıq açarlar) ---
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" və ya "publishable" açar (RLS ilə qorunur, açıq ola bilər)
VITE_SUPABASE_ANON_KEY=

# --- Yalnız lokal skriptlər üçün (scripts/, evals/). HEÇ VAXT VITE_ prefiksi ilə yazmayın ---
# Demo hesablarını yaratmaq üçün (npm run seed:demo)
SUPABASE_SERVICE_ROLE_KEY=
# AI eval üçün (npm run eval). Edge Function üçün açar Supabase Secrets-də saxlanılır.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
